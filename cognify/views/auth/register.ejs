<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="auth-body">
  <main class="auth-shell">
    <section class="auth-visual">
      <a class="brand-lockup" href="/login">
        <span class="brand-mark">C</span>
        <span><strong>Cognifyz</strong><small>Secure MERN</small></span>
      </a>
      <div>
        <span class="section-kicker">JWT + MongoDB Atlas</span>
        <h1>Create your secure workspace for student management.</h1>
        <p>Passwords are hashed with bcrypt and dashboard access is protected with signed JWT cookies.</p>
      </div>
    </section>

    <section class="auth-panel">
      <form class="auth-card" id="registerForm" novalidate>
        <span class="section-kicker">Create Account</span>
        <h2>Start securely</h2>
        <p>Register once, then manage students from your protected dashboard.</p>

        <div class="form-floating-icon input-group">
          <i class="fa-regular fa-user"></i>
          <input class="form-control" type="text" id="name" name="name" placeholder="Full Name" required>
          <label for="name">Full Name</label>
          <small class="error-message" data-error-for="name"></small>
        </div>

        <div class="form-floating-icon input-group">
          <i class="fa-regular fa-envelope"></i>
          <input class="form-control" type="email" id="email" name="email" placeholder="Email Address" required>
          <label for="email">Email Address</label>
          <small class="error-message" data-error-for="email"></small>
        </div>

        <div class="form-floating-icon input-group">
          <i class="fa-solid fa-lock"></i>
          <input class="form-control" type="password" id="password" name="password" placeholder="Password" required>
          <label for="password">Password</label>
          <button type="button" class="icon-action toggle-password" data-target="password" aria-label="Show password"><i class="fa-regular fa-eye"></i></button>
          <div class="strength-track"><span id="strengthBar"></span></div>
          <small id="strengthText" class="hint-text">Password strength: waiting</small>
          <small class="error-message" data-error-for="password"></small>
        </div>

        <div class="form-floating-icon input-group">
          <i class="fa-solid fa-key"></i>
          <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" required>
          <label for="confirmPassword">Confirm Password</label>
          <button type="button" class="icon-action toggle-password" data-target="confirmPassword" aria-label="Show confirm password"><i class="fa-regular fa-eye"></i></button>
          <small class="error-message" data-error-for="confirmPassword"></small>
        </div>

        <button class="btn btn-brand btn-ripple auth-submit" type="submit">
          <i class="fa-solid fa-user-shield"></i>
          <span>Create Account</span>
        </button>

        <p class="auth-switch">Already registered? <a href="/login">Login</a></p>
      </form>
    </section>
  </main>

  <div class="toast-region" id="toastRegion" aria-live="polite"></div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script type="module" src="/js/auth/register.js"></script>
</body>
</html>
